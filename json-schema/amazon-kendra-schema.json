{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apievangelist.com/amazon-kendra/index-definition",
  "title": "Amazon Kendra Index Definition",
  "description": "Schema defining the structure of an Amazon Kendra search index, including configuration, data sources, document metadata, and relevance tuning settings.",
  "type": "object",
  "required": [
    "name",
    "roleArn"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "The unique identifier of the index."
    },
    "name": {
      "type": "string",
      "description": "The name of the index.",
      "minLength": 1,
      "maxLength": 1000
    },
    "description": {
      "type": "string",
      "description": "A description for the index."
    },
    "edition": {
      "type": "string",
      "enum": [
        "DEVELOPER_EDITION",
        "ENTERPRISE_EDITION"
      ],
      "description": "The Amazon Kendra edition to use for the index."
    },
    "roleArn": {
      "type": "string",
      "description": "The IAM role that gives Amazon Kendra permissions to access resources."
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATING",
        "ACTIVE",
        "DELETING",
        "FAILED",
        "UPDATING",
        "SYSTEM_UPDATING"
      ],
      "description": "The current status of the index."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the index was created."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "The timestamp when the index was last updated."
    },
    "capacityUnits": {
      "$ref": "#/$defs/CapacityUnits"
    },
    "documentMetadataConfigurations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocumentMetadataConfiguration"
      },
      "description": "Document metadata field configurations."
    },
    "dataSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataSource"
      },
      "description": "Data source connectors for the index."
    },
    "serverSideEncryptionConfiguration": {
      "type": "object",
      "properties": {
        "kmsKeyId": {
          "type": "string",
          "description": "The KMS key ID for server-side encryption."
        }
      }
    }
  },
  "$defs": {
    "CapacityUnits": {
      "type": "object",
      "description": "Capacity units for the index.",
      "properties": {
        "storageCapacityUnits": {
          "type": "integer",
          "minimum": 0,
          "description": "The amount of extra storage capacity for the index."
        },
        "queryCapacityUnits": {
          "type": "integer",
          "minimum": 0,
          "description": "The amount of extra query capacity for the index."
        }
      }
    },
    "DocumentMetadataConfiguration": {
      "type": "object",
      "description": "Configuration for a document metadata field.",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the document metadata field."
        },
        "type": {
          "type": "string",
          "enum": [
            "STRING_VALUE",
            "STRING_LIST_VALUE",
            "LONG_VALUE",
            "DATE_VALUE"
          ],
          "description": "The data type of the field."
        },
        "relevance": {
          "type": "object",
          "properties": {
            "freshness": {
              "type": "boolean"
            },
            "importance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "rankOrder": {
              "type": "string",
              "enum": [
                "ASCENDING",
                "DESCENDING"
              ]
            }
          },
          "description": "Relevance tuning configuration for the field."
        },
        "search": {
          "type": "object",
          "properties": {
            "facetable": {
              "type": "boolean"
            },
            "searchable": {
              "type": "boolean"
            },
            "displayable": {
              "type": "boolean"
            },
            "sortable": {
              "type": "boolean"
            }
          },
          "description": "Search configuration for the field."
        }
      }
    },
    "DataSource": {
      "type": "object",
      "description": "A data source connector for an index.",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier of the data source."
        },
        "name": {
          "type": "string",
          "description": "The name of the data source."
        },
        "type": {
          "type": "string",
          "enum": [
            "S3",
            "SHAREPOINT",
            "DATABASE",
            "SALESFORCE",
            "ONEDRIVE",
            "SERVICENOW",
            "CUSTOM",
            "CONFLUENCE",
            "GOOGLEDRIVE",
            "WEBCRAWLER",
            "WORKDOCS",
            "FSX",
            "SLACK",
            "BOX",
            "QUIP",
            "JIRA",
            "GITHUB",
            "ALFRESCO",
            "TEMPLATE"
          ],
          "description": "The type of the data source."
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATING",
            "DELETING",
            "FAILED",
            "UPDATING",
            "ACTIVE"
          ],
          "description": "The status of the data source."
        },
        "schedule": {
          "type": "string",
          "description": "The schedule for data source sync in cron format."
        },
        "roleArn": {
          "type": "string",
          "description": "The IAM role for the data source."
        }
      }
    }
  }
}
