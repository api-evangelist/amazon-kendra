{
  "@context": {
    "@vocab": "https://schema.org/",
    "kendra": "https://docs.aws.amazon.com/kendra/latest/APIReference/",
    "aws": "https://aws.amazon.com/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",

    "Index": {
      "@id": "kendra:API_DescribeIndex",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "name": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "description": {
          "@id": "schema:description",
          "@type": "xsd:string"
        },
        "edition": {
          "@id": "kendra:indexEdition",
          "@type": "xsd:string"
        },
        "roleArn": {
          "@id": "kendra:roleArn",
          "@type": "xsd:string"
        },
        "status": {
          "@id": "kendra:indexStatus",
          "@type": "xsd:string"
        },
        "createdAt": {
          "@id": "schema:dateCreated",
          "@type": "xsd:dateTime"
        },
        "updatedAt": {
          "@id": "schema:dateModified",
          "@type": "xsd:dateTime"
        },
        "capacityUnits": {
          "@id": "kendra:capacityUnits",
          "@type": "kendra:CapacityUnits"
        }
      }
    },

    "DataSource": {
      "@id": "kendra:API_DescribeDataSource",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "name": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "type": {
          "@id": "kendra:dataSourceType",
          "@type": "xsd:string"
        },
        "status": {
          "@id": "kendra:dataSourceStatus",
          "@type": "xsd:string"
        },
        "schedule": {
          "@id": "kendra:syncSchedule",
          "@type": "xsd:string"
        },
        "roleArn": {
          "@id": "kendra:roleArn",
          "@type": "xsd:string"
        },
        "createdAt": {
          "@id": "schema:dateCreated",
          "@type": "xsd:dateTime"
        },
        "updatedAt": {
          "@id": "schema:dateModified",
          "@type": "xsd:dateTime"
        }
      }
    },

    "QueryResult": {
      "@id": "kendra:API_Query",
      "@context": {
        "queryId": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "resultItems": {
          "@id": "kendra:resultItems",
          "@container": "@list"
        },
        "totalNumberOfResults": {
          "@id": "kendra:totalResults",
          "@type": "xsd:integer"
        },
        "facetResults": {
          "@id": "kendra:facetResults",
          "@container": "@list"
        }
      }
    },

    "Document": {
      "@id": "kendra:API_Document",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "title": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "contentType": {
          "@id": "schema:encodingFormat",
          "@type": "xsd:string"
        },
        "attributes": {
          "@id": "kendra:documentAttributes",
          "@container": "@list"
        }
      }
    },

    "Experience": {
      "@id": "kendra:API_DescribeExperience",
      "@context": {
        "id": {
          "@id": "schema:identifier",
          "@type": "xsd:string"
        },
        "name": {
          "@id": "schema:name",
          "@type": "xsd:string"
        },
        "description": {
          "@id": "schema:description",
          "@type": "xsd:string"
        },
        "status": {
          "@id": "kendra:experienceStatus",
          "@type": "xsd:string"
        },
        "roleArn": {
          "@id": "kendra:roleArn",
          "@type": "xsd:string"
        }
      }
    }
  }
}
